# Copy to slurm/local.env (git-ignored) and set paths valid on the compute node.
export PYTHON_LINGSHU=/path/to/envs/lingshu/bin/python
export PYTHON_JUDGE=/path/to/envs/judge/bin/python
export PYTHON_MAIRA2=/path/to/envs/maira2/bin/python
# Optional: a writable home on the compute node (needed for MAIRA-2 remote code cache)
export HOME_OVERRIDE=/path/to/writable/home
